# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=PASTE_TOKEN_HERE

# Scanner cadence. 300 = every 5 minutes.
SCAN_INTERVAL_SECONDS=300

# Directional market score is 0..100, with 50 neutral.
ALERT_UPPER=72
ALERT_LOWER=28
ALERT_COOLDOWN_MINUTES=60

# Paper trades are simulated only; no broker/exchange orders are sent.
PAPER_TRADING=true
PAPER_ENTRY_UPPER=75
PAPER_ENTRY_LOWER=25
PAPER_RISK_ATR=1.25
PAPER_REWARD_R=1.75

DB_PATH=tradeify_v1.db
LOG_LEVEL=INFO
